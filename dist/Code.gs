// RTG Heater Store backend, all files combined. GENERATED by tools/build.py.

// ===== Auth.gs =====
// Login with the app's own user IDs. Passwords are stored as salted SHA-256 hashes, never in plain text.

var SESSION_SECONDS = 6 * 60 * 60; // Apps Script cache maximum
var MAX_FAILED_LOGINS = 5;
var ROLES = ['Admin', 'Local', 'HOD', 'RTG Chief', 'FM Chief'];

function hashPassword(password, salt) {
  var value = salt + ':' + password;
  for (var i = 0; i < 50; i++) {
    value = Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, value, Utilities.Charset.UTF_8));
  }
  return value;
}

function newSalt() {
  return Utilities.getUuid().replace(/-/g, '');
}

function randomPassword() {
  var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  var raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, Utilities.getUuid());
  var out = '';
  for (var i = 0; i < 10; i++) out += chars.charAt((raw[i] + 256) % chars.length);
  return out;
}

function publicUser(u) {
  return { UserID: u.UserID, Name: u.Name, EmployeeID: u.EmployeeID, Email: u.Email, Role: u.Role, Team: u.Team,
           Department: u.Department, Phone: u.Phone, Active: u.Active, MustChangePassword: u.MustChangePassword === true || u.MustChangePassword === 'TRUE' };
}

function login(userId, password) {
  userId = String(userId || '').trim();
  var cache = CacheService.getScriptCache();
  var failKey = 'fail:' + userId.toLowerCase();
  var fails = Number(cache.get(failKey) || 0);
  if (fails >= MAX_FAILED_LOGINS) throw new Error('Too many failed attempts. Try again in 15 minutes.');

  var u = readTable('Users').filter(function (x) { return String(x.UserID).toLowerCase() === userId.toLowerCase(); })[0];
  if (!u || !isActive_(u) || hashPassword(String(password || ''), u.Salt) !== u.PasswordHash) {
    cache.put(failKey, String(fails + 1), 15 * 60);
    throw new Error('Wrong user ID or password.');
  }
  cache.remove(failKey);
  var token = Utilities.getUuid() + Utilities.getUuid().slice(0, 8);
  cache.put('sess:' + token, u.UserID, SESSION_SECONDS);
  audit(u.UserID, 'login');
  return { token: token, user: publicUser(u) };
}

function logout(token) {
  CacheService.getScriptCache().remove('sess:' + token);
  return { ok: true };
}

function isActive_(u) {
  return u.Active === true || u.Active === 'TRUE' || u.Active === 'Y';
}

// Returns the logged-in user, or throws. Pass roles to restrict an action.
function requireUser(token, roles) {
  var cache = CacheService.getScriptCache();
  var userId = token && cache.get('sess:' + token);
  if (!userId) throw new AuthError('Session expired. Please log in again.');
  var u = findOne('Users', 'UserID', userId);
  if (!u || !isActive_(u)) throw new AuthError('Account disabled.');
  if (roles && roles.indexOf(u.Role) < 0) throw new Error('You do not have permission for this.');
  cache.put('sess:' + token, userId, SESSION_SECONDS); // sliding expiry
  return u;
}

function AuthError(message) {
  this.message = message;
  this.auth = true;
}
AuthError.prototype = Object.create(Error.prototype);

function changePassword(user, oldPassword, newPassword) {
  if (hashPassword(String(oldPassword || ''), user.Salt) !== user.PasswordHash) throw new Error('Current password is wrong.');
  if (String(newPassword || '').length < 8) throw new Error('New password must be at least 8 characters.');
  var salt = newSalt();
  updateWhere('Users', 'UserID', user.UserID, { Salt: salt, PasswordHash: hashPassword(newPassword, salt), MustChangePassword: false });
  audit(user.UserID, 'changePassword');
  return { ok: true };
}


// ===== Code.gs =====
// JSON API for the GitHub Pages front end.
// The front end POSTs {action, token, data} as text/plain (avoids the CORS preflight Apps Script can't answer).

var ADMIN = ['Admin'];
var READ_ONLY = ['me', 'lookups', 'heaterSearch', 'components', 'listUsers', 'listRequests', 'getRequest', 'dashboard', 'listTransfers'];

// action -> { roles: who may call it (null = any logged-in user), run: function(user, data) }
var ACTIONS = {
  me:             { roles: null,  run: function (u) { return { user: publicUser(u) }; } },
  changePassword: { roles: null,  run: function (u, d) { return changePassword(u, d.oldPassword, d.newPassword); } },
  lookups:        { roles: null,  run: function () { return apiLookups(); } },
  heaterSearch:   { roles: null,  run: function (u, d) { return apiHeaterSearch(d); } },
  components:     { roles: ADMIN, run: function (u, d) { return apiComponents(d); } },
  listUsers:      { roles: ADMIN, run: function () { return listUsers(); } },
  saveUser:       { roles: ADMIN, run: function (u, d) { return saveUser(u, d); } },
  resetPassword:  { roles: ADMIN, run: function (u, d) { return resetPassword(u, d.UserID); } },
  raiseRequest:   { roles: null,  run: function (u, d) { return raiseRequest(u, d); } },
  listRequests:   { roles: null,  run: function () { return listRequests(); } },
  getRequest:     { roles: null,  run: function (u, d) { return getRequest(u, d); } },
  dashboard:      { roles: null,  run: function (u) { return dashboard(u); } },
  decideRequest:  { roles: ADMIN, run: function (u, d) { return decideRequest(u, d); } },
  issueTicket:    { roles: ADMIN, run: function (u, d) { return issueTicket(u, d); } },
  returnTicket:   { roles: ADMIN, run: function (u, d) { return returnTicket(u, d); } },
  closeIssue:     { roles: ADMIN, run: function (u, d) { return closeIssue(u, d); } },
  maintenance:    { roles: ADMIN, run: function (u, d) { return completeMaintenance(u, d); } },
  markFound:      { roles: ADMIN, run: function (u, d) { return markFound(u, d); } },
  raiseTransfer:  { roles: null,  run: function (u, d) { return raiseTransfer(u, d); } },
  decideTransfer: { roles: null,  run: function (u, d) { return decideTransfer(u, d); } },
  listTransfers:  { roles: null,  run: function (u) { return listTransfers(u); } }
};

function doPost(e) {
  var req;
  try {
    req = JSON.parse(e.postData.contents);
  } catch (err) {
    return json_({ ok: false, error: 'Bad request.' });
  }
  return json_(handle(req));
}

function doGet() {
  return json_({ ok: true, app: 'RTG Heater API' });
}

// Separate from doPost so tests can call it directly.
function handle(req) {
  try {
    if (req.action === 'login') return { ok: true, data: login(req.data.userId, req.data.password) };
    if (req.action === 'logout') return { ok: true, data: logout(req.token) };
    var a = ACTIONS[req.action];
    if (!a) return { ok: false, error: 'Unknown action: ' + req.action };
    var user = requireUser(req.token, a.roles);
    if (READ_ONLY.indexOf(req.action) >= 0) return { ok: true, data: a.run(user, req.data || {}) };
    // One writer at a time, so two people can't approve or issue the same thing at once.
    var lock = LockService.getScriptLock();
    lock.waitLock(25000);
    try {
      return { ok: true, data: a.run(user, req.data || {}) };
    } finally {
      lock.releaseLock();
    }
  } catch (err) {
    return { ok: false, error: err.message || String(err), auth: !!err.auth };
  }
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}


// ===== Db.gs =====
// Thin table layer over the Sheet: each tab is a table, row 1 is the header.

function sheet_(name) {
  var sh = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sh) throw new Error('Missing tab "' + name + '". Run setup() first.');
  return sh;
}

function readTable(name) {
  var values = sheet_(name).getDataRange().getValues();
  var head = values[0];
  var rows = [];
  for (var r = 1; r < values.length; r++) {
    if (values[r].join('') === '') continue;
    var o = {};
    for (var c = 0; c < head.length; c++) o[head[c]] = cell_(values[r][c]);
    rows.push(o);
  }
  return rows;
}

function cell_(v) {
  if (v instanceof Date) {
    var hasTime = v.getHours() || v.getMinutes();
    return Utilities.formatDate(v, Session.getScriptTimeZone(), hasTime ? 'yyyy-MM-dd HH:mm' : 'yyyy-MM-dd');
  }
  return v;
}

function today() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function appendRows(name, objs) {
  if (!objs.length) return;
  var sh = sheet_(name);
  // Use the tab's real header so a column moved by hand still lines up.
  var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
  var rows = objs.map(function (o) {
    return head.map(function (h) { return o[h] === undefined ? '' : o[h]; });
  });
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, head.length).setValues(rows);
}

function appendRow(name, obj) {
  appendRows(name, [obj]);
}

// Merge `patch` into every row where keyCol === keyVal. Returns the number of rows changed.
function updateWhere(name, keyCol, keyVal, patch) {
  var sh = sheet_(name);
  var values = sh.getDataRange().getValues();
  var head = values[0];
  var k = head.indexOf(keyCol);
  var changed = 0;
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][k]) !== String(keyVal)) continue;
    Object.keys(patch).forEach(function (col) {
      var c = head.indexOf(col);
      if (c >= 0) values[r][c] = patch[col];
    });
    sh.getRange(r + 1, 1, 1, head.length).setValues([values[r]]);
    changed++;
  }
  return changed;
}

// One read and one write for many rows: fn(rowObject) returns a patch {col: value} or null.
function updateRows(name, fn) {
  var sh = sheet_(name);
  var values = sh.getDataRange().getValues();
  var head = values[0];
  var changed = 0;
  for (var r = 1; r < values.length; r++) {
    var o = {};
    for (var c = 0; c < head.length; c++) o[head[c]] = cell_(values[r][c]);
    var patch = fn(o);
    if (!patch) continue;
    Object.keys(patch).forEach(function (col) {
      var i = head.indexOf(col);
      if (i >= 0) values[r][i] = patch[col];
    });
    changed++;
  }
  if (changed) sh.getRange(1, 1, values.length, head.length).setValues(values);
  return changed;
}

// patches = {keyValue: {col: value}}
function updateMany(name, keyCol, patches) {
  return updateRows(name, function (o) { return patches[String(o[keyCol])] || null; });
}

function findOne(name, keyCol, keyVal) {
  var rows = readTable(name);
  for (var i = 0; i < rows.length; i++) if (String(rows[i][keyCol]) === String(keyVal)) return rows[i];
  return null;
}

function getSetting(key, fallback) {
  var row = findOne('Settings', 'Key', key);
  return row && row.Value !== '' ? row.Value : fallback;
}

// Next sequential number for a counter. Callers run inside handle()'s script lock, so numbers never repeat.
function nextNumber(counter, prefix) {
  var row = findOne('Counters', 'Name', counter);
  var n = (row ? Number(row.Value) : 0) + 1;
  if (row) updateWhere('Counters', 'Name', counter, { Value: n });
  else appendRow('Counters', { Name: counter, Value: n });
  return formatNumber(prefix, n, 4);
}

function audit(userId, action, ref, details) {
  appendRow('AuditLog', { Time: new Date(), UserID: userId, Action: action, Ref: ref || '', Details: details ? JSON.stringify(details) : '' });
}


