    model: model,
    madeFrom: from.slice(1),
    blockedBy: blockedBy,
    totalSets: completeSets(types, owned),
    availableSets: available,
    deployedCount: deps.length,
    deployments: deps,
    shortages: shortages,
    componentList: types.map(function (t) {
