// RTG Heater Store backend, all files combined. GENERATED by tools/build.py.

// ===== Admin.gs =====
// Admin page for what used to be typed straight into the Sheet: settings, the conveyor and department lists,
// and the activity and mail logs. (On Supabase the Sheet is only a nightly copy, so changes there are overwritten.)

// key: the column that names a row. fixed: rows can't be added or removed, only these columns edited.
var MASTER_TABS = {
  Settings:    { key: 'Key', fixed: ['Value'] },
  Conveyors:   { key: 'ConveyorName', numbers: ['BeltWidth_mm', 'Plies'], rating: 'BeltRating_Nmm' },
  Departments: { key: 'Department' }
};
var HIDDEN_SETTINGS = ['ChecklistFolderId'];
var LOG_TABS = ['AuditLog', 'MailOutbox'];
var LOG_LIMIT = 300;

function masterTab_(tab) {
  var t = MASTER_TABS[tab];
  if (!t) throw new Error('This list cannot be edited here.');
  return t;
}

function apiMasterList(d) {
  var t = masterTab_(d.tab);
  var rows = readTable(d.tab);
  if (d.tab === 'Settings') rows = rows.filter(function (r) { return HIDDEN_SETTINGS.indexOf(r.Key) < 0; }).concat(newSettings_(rows));
  var out = { tab: d.tab, key: t.key, columns: SCHEMA[d.tab], fixed: t.fixed || null, rows: rows };
  if (d.tab === 'Conveyors') out.heaters = conveyorHeaters_(rows);
  return out;
}

// Settings added by a newer app version that this database doesn't have a row for yet. They show empty and are saved as new rows.
function newSettings_(rows) {
  var have = {};
  rows.forEach(function (r) { have[r.Key] = true; });
  return DEFAULT_SETTINGS.filter(function (x) { return !have[x[0]]; }).map(function (x) { return { Key: x[0], Value: x[1], Notes: x[2] }; });
}

// For each conveyor, the heaters the selection guide gives for its belt (or the models' ranges when there is no guide).
function conveyorHeaters_(rows) {
  var guide = readTable('HeaterSelection'), models = readTable('HeaterModels'), out = {};
  rows.forEach(function (c) {
    var w = Number(c.BeltWidth_mm), ids = [];
    if (w > 0 && String(c.BeltRating_Nmm).trim() !== '') {
      if (guide.length) {
        guideMatches(guide, w, String(c.BeltRating_Nmm), Number(c.Plies) || 0).forEach(function (g) {
          String(g.HeaterIDs || '').split(/[,;\n]/).forEach(function (x) { x = x.trim(); if (x && ids.indexOf(x) < 0) ids.push(x); });
        });
      } else {
        ids = models.filter(function (m) { return isSuitable(m, w, ratingNum_(c.BeltRating_Nmm), Number(c.Plies) || 0); }).map(function (m) { return m.ModelID; });
      }
    }
    out[c.ConveyorName] = ids;
  });
  return out;
}

// Adds or updates rows by their key. d.rows: [{col: value}], d.originalKey: set when one row is renamed.
function apiMasterSave(admin, d) {
  var t = masterTab_(d.tab);
  var rows = parseList_(d.rows);
  if (!rows.length) throw new Error('Nothing to save.');
  if (rows.length > 2000) throw new Error('Please save at most 2000 rows at a time.');
  var existing = {};
  readTable(d.tab).forEach(function (r) { existing[String(r[t.key]).toLowerCase()] = r; });
  var seen = {}, adds = [], patches = {}, errors = [];
  rows.forEach(function (r, i) {
    var key = String(r[t.key] === undefined ? '' : r[t.key]).trim();
    var where = rows.length > 1 ? 'Row ' + (i + 1) + ': ' : '';
    if (!key) return errors.push(where + t.key + ' is required.');
    if (seen[key.toLowerCase()]) return errors.push(where + '"' + key + '" appears twice.');
    seen[key.toLowerCase()] = true;
    var clean = {};
    SCHEMA[d.tab].forEach(function (c) {
      if (r[c] === undefined || (t.fixed && t.fixed.indexOf(c) < 0)) return;
      var v = String(r[c]).trim();
      if (t.numbers && t.numbers.indexOf(c) >= 0 && v !== '') {
        if (isNaN(Number(v))) return errors.push(where + c + ' must be a number.');
        v = Number(v);
      }
      if (c === t.rating && v !== '') {
        if (!normRating(v)) return errors.push(where + 'Belt rating "' + v + '" should be a number like 1000, or ST1000 / ST-1600 for a steel-cord belt.');
        v = normRating(v);
        if (/^\d+$/.test(v)) v = Number(v);
      }
      clean[c] = v;
    });
    // A steel-cord belt has no plies.
    if (t.rating && /^ST/.test(String(clean[t.rating] || ''))) clean.Plies = '';
    var renamedFrom = rows.length === 1 && d.originalKey && String(d.originalKey).toLowerCase() !== key.toLowerCase() ? String(d.originalKey) : '';
    if (renamedFrom && existing[key.toLowerCase()]) return errors.push('"' + key + '" already exists.');
    var old = existing[(renamedFrom || key).toLowerCase()];
    if (old) {
      clean[t.key] = key;
      patches[String(old[t.key])] = clean;
    } else if (t.fixed) {
      var def = d.tab === 'Settings' && DEFAULT_SETTINGS.filter(function (x) { return x[0] === key; })[0];
      if (!def) return errors.push(where + '"' + key + '" is not a setting.');
      adds.push({ Key: key, Value: clean.Value === undefined ? def[1] : clean.Value, Notes: def[2] });
    } else {
      clean[t.key] = key;
      adds.push(clean);
    }
  });
  if (errors.length) throw new Error(errors.slice(0, 5).join(' ') + (errors.length > 5 ? ' (' + errors.length + ' problems)' : ''));
  if (Object.keys(patches).length) updateMany(d.tab, t.key, patches);
  if (adds.length) appendRows(d.tab, adds);
  audit(admin.UserID, 'saveList', d.tab, { added: adds.length, updated: Object.keys(patches).length, keys: rows.slice(0, 20).map(function (r) { return r[t.key]; }) });
  return { added: adds.length, updated: Object.keys(patches).length };
}

function apiMasterDelete(admin, d) {
  var t = masterTab_(d.tab);
  if (t.fixed) throw new Error('Settings cannot be deleted; clear the value instead.');
  if (!deleteWhere(d.tab, t.key, d.key)) throw new Error('"' + d.key + '" was not found.');
  audit(admin.UserID, 'deleteFromList', d.tab, { key: d.key });
  return { ok: true };
}

// ---------- heater selection guide ----------
// The RTG guide is replaced as a whole. It is read from the guide's own layout: width, rating ("1000/5" or
// "ST1600"; plies may also be a column of their own) and the heater numbers ("12EF, 12GH" or "12-EF").
function apiHeaterGuide() {
  return { rows: readTable('HeaterSelection'), models: readTable('HeaterModels').map(function (m) { return m.ModelID; }) };
}

function heaterId_(v) {
  var t = String(v || '').trim().toUpperCase().replace(/\s+/g, '');
  var m = t.match(/^(\d+)-?([A-Z]+)$/);
  return m ? m[1] + '-' + m[2] : t;
}

function apiSaveHeaterGuide(admin, d) {
  var rows = parseList_(d.rows);
  if (!rows.length) throw new Error('The guide is empty.');
  var models = {};
  readTable('HeaterModels').forEach(function (m) { models[String(m.ModelID).toUpperCase()] = m.ModelID; });
  var out = [], errors = [], seen = {};
  rows.forEach(function (r, i) {
    var where = 'Row ' + (i + 2) + ': ';
    var width = Number(String(r.BeltWidth_mm === undefined ? '' : r.BeltWidth_mm).trim());
    var raw = String(r.BeltRating === undefined ? '' : r.BeltRating).toUpperCase().replace(/\s+/g, '');
    var plies = String(r.Plies === undefined ? '' : r.Plies).trim();
    var both = raw.match(/^(\d+)\/(\d+)$/);
    if (both) { raw = both[1]; plies = both[2]; }
    var rating = normRating(raw);
    if (!(width > 0)) return errors.push(where + 'width "' + r.BeltWidth_mm + '" is not a number.');
    if (!rating) return errors.push(where + 'rating "' + r.BeltRating + '" should look like 1000/5, ST1600 or ST-1600.');
    if (/^ST/.test(rating)) plies = '';
    else if (plies !== '' && !(Number(plies) > 0)) return errors.push(where + 'plies "' + plies + '" is not a number.');
    var ids = String(r.HeaterIDs || '').split(/[,;\n]/).map(heaterId_).filter(String);
    if (!ids.length) return errors.push(where + 'no heater numbers.');
    var unknown = ids.filter(function (id) { return !models[id]; });
    if (unknown.length) return errors.push(where + 'heater ' + unknown.join(', ') + ' is not in the heater list. Add it on the Heaters tab first.');
    var k = width + '|' + rating + '|' + plies;
    if (seen[k]) return errors.push(where + width + ' / ' + rating + (plies ? '/' + plies : '') + ' appears twice.');
    seen[k] = true;
    out.push({ BeltWidth_mm: width, BeltRating: rating, Plies: plies === '' ? '' : Number(plies),
               HeaterIDs: ids.map(function (id) { return models[id]; }).join(', '), Notes: String(r.Notes || '').trim() });
  });
  if (errors.length) throw new Error(errors.slice(0, 6).join(' ') + (errors.length > 6 ? ' (' + errors.length + ' problems in all)' : ''));
  var sh = sheet_('HeaterSelection');
  if (sh.getLastRow() > 1) sh.deleteRows(2, sh.getLastRow() - 1);
  appendRows('HeaterSelection', out);
  audit(admin.UserID, 'saveHeaterGuide', '', { rows: out.length });
  return { rows: out.length };
}

// ---------- heater list ----------
// Short codes for part IDs, as in the RTG component list (12-G-HP1, 12-G-CB, 12-G-P631...).
// Cross beams and end bolts are counted as one lot; every other part has its own ID.
var PART_CODES = {
  'Heating Platen': 'HP', 'Cross Beam': 'CB', 'Pressure Plate': 'PRP', 'End Bolt & Nut': 'BN', 'Edge Bar': 'EBAR', 'Edge Clamp': 'ECL',
  'Control Panel': 'CP', 'Incoming Cable': 'IC', 'Outgoing Cable': 'OC', 'Distributor Block with Water Pressure Hose': 'DBP',
  'Distributor Block with Water Cooling Hose (Input)': 'DBC', 'Water Pressure Bag': 'WPB', 'Pressure Ply (Wooden)': 'PLY',
  'Water Pump Unit': 'WPU', '63A DS-6 Plug': 'P63', '125A DS-9 Plug': 'P125', 'JB Box': 'JB'
};
var LOT_PARTS = ['Cross Beam', 'End Bolt & Nut'];

function partCode_(name) {
  return PART_CODES[name] || String(name).replace(/[^A-Za-z0-9 ]/g, ' ').split(/\s+/).filter(String).map(function (w) { return w.charAt(0).toUpperCase(); }).join('');
}

function apiListHeaters() {
  var types = readTable('ComponentTypes'), comps = readTable('Components'), names = [];
  types.forEach(function (t) { if (names.indexOf(t.ComponentName) < 0) names.push(t.ComponentName); });
  Object.keys(PART_CODES).forEach(function (n) { if (names.indexOf(n) < 0) names.push(n); });
  return {
    partNames: names,
    heaters: readTable('HeaterModels').map(function (m) {
      return { ModelID: m.ModelID, ModelName: m.ModelName, MadeFrom: m.MadeFrom,
               parts: types.filter(function (t) { return t.ModelID === m.ModelID; }).map(function (t) { return { name: t.ComponentName, qty: Number(t.QtyPerSet) || 0 }; }),
               rows: comps.filter(function (c) { return c.ModelID === m.ModelID; }).length };
    })
  };
}

// Adds a new (single, not paired) heater with one full set of parts in the store.
function apiAddHeater(admin, d) {
  var id = heaterId_(d.ModelID);
  if (!id) throw new Error('Heater number is required.');
  if (readTable('HeaterModels').some(function (m) { return String(m.ModelID).toUpperCase() === id; })) throw new Error('Heater ' + id + ' already exists.');
  var parts = parseList_(d.parts).map(function (p) { return { name: String(p.name || '').trim(), qty: Number(p.qty) }; }).filter(function (p) { return p.name && p.qty; });
  if (!parts.length) throw new Error('Give the number of each part this heater has.');
  parts.forEach(function (p) { if (!(p.qty > 0) || p.qty % 1) throw new Error('The number for ' + p.name + ' must be a whole number.'); });
  var types = [], comps = [];
  parts.forEach(function (p) {
    var lot = LOT_PARTS.indexOf(p.name) >= 0, code = partCode_(p.name);
    types.push({ ModelID: id, ComponentName: p.name, QtyPerSet: p.qty, IsSerialised: lot ? 'N' : 'Y' });
    var base = { ModelID: id, SetNo: 1, ComponentName: p.name, Condition: CONDITION.OK, Status: STATUS.IN_STORE, MaintenanceStatus: MAINT.OK, JointsSinceMaintenance: 0 };
    if (lot || p.qty === 1) comps.push(Object.assign({}, base, { ComponentID: id + '-' + code, Qty: p.qty }));
    else for (var n = 1; n <= p.qty; n++) comps.push(Object.assign({}, base, { ComponentID: id + '-' + code + n, Qty: 1 }));
  });
  var taken = {};
  readTable('Components').forEach(function (c) { taken[c.ComponentID] = true; });
  comps.forEach(function (c) { if (taken[c.ComponentID]) throw new Error('Part ID ' + c.ComponentID + ' is already used.'); });
  appendRow('HeaterModels', { ModelID: id, ModelName: String(d.ModelName || '').trim() || 'Heater ' + id, Notes: String(d.Notes || '').trim() });
  appendRows('ComponentTypes', types);
  appendRows('Components', comps);
  audit(admin.UserID, 'addHeater', id, { parts: comps.length });
  return { ModelID: id, parts: comps.length };
}

// The newest LOG_LIMIT rows of the activity log or the mail log, newest first.
function apiLog(d) {
  var tab = LOG_TABS.indexOf(d.log) >= 0 ? d.log : 'AuditLog';
  var rows = readTable(tab);
  return { log: tab, columns: SCHEMA[tab], rows: rows.slice(-LOG_LIMIT).reverse(), more: rows.length > LOG_LIMIT };
}


// ===== Auth.gs =====
// Login with the app's own user IDs. Passwords are stored as salted SHA-256 hashes, never in plain text.

var SESSION_SECONDS = 6 * 60 * 60; // Apps Script cache maximum
var MAX_FAILED_LOGINS = 5;
var ROLES = ['Admin', 'Local', 'HOD', 'RTG Chief', 'FM Chief'];
// FM: field maintenance, asks for heaters. Vendor: the jointing contractors, ask for consumables.
// RTG: the store team; they see and keep the stock, approve, issue, maintain the heaters and take back.
// RTG Vendor: the store's maintenance contractor; checks heaters before issue and after return, and logs maintenance (RTG verifies it).
var TEAMS = ['FM', 'Vendor', 'RTG', 'RTG Vendor'];

// Who may do what. Admins may do everything.
function isAdminUser_(u) { return !!u && u.Role === 'Admin'; }
// The RTG team runs the store: sees and changes the stock, approves, issues, takes back and maintains.
function isRtgTeam_(u) { return isAdminUser_(u) || (!!u && u.Team === 'RTG'); }
// Logs heater maintenance and sees the maintenance logs.
function canMaintain_(u) { return isRtgTeam_(u) || (!!u && u.Team === 'RTG Vendor'); }

function hashPassword(password, salt) {
  var value = salt + ':' + password;
  for (var i = 0; i < 50; i++) {
    value = Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, value, Utilities.Charset.UTF_8));
  }
  return value;
}

function newSalt() {
  return Utilities.getUuid().replace(/-/g, '');
}

function randomPassword() {
  var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  var raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, Utilities.getUuid());
  var out = '';
  for (var i = 0; i < 10; i++) out += chars.charAt((raw[i] + 256) % chars.length);
  return out;
}

function publicUser(u) {
  return { UserID: u.UserID, Name: u.Name, EmployeeID: u.EmployeeID, Email: u.Email, Role: u.Role, Team: u.Team,
           Department: u.Department, Phone: u.Phone, Active: u.Active, MustChangePassword: u.MustChangePassword === true || u.MustChangePassword === 'TRUE' };
}

function login(userId, password) {
  userId = String(userId || '').trim();
  var cache = CacheService.getScriptCache();
  var failKey = 'fail:' + userId.toLowerCase();
  var fails = Number(cache.get(failKey) || 0);
  if (fails >= MAX_FAILED_LOGINS) throw new Error('Too many failed attempts. Try again in 15 minutes.');

  var u = readTable('Users').filter(function (x) { return String(x.UserID).toLowerCase() === userId.toLowerCase(); })[0];
  if (!u || !isActive_(u) || hashPassword(String(password || ''), u.Salt) !== u.PasswordHash) {
    cache.put(failKey, String(fails + 1), 15 * 60);
    throw new Error('Wrong user ID or password.');
  }
  cache.remove(failKey);
  var token = Utilities.getUuid() + Utilities.getUuid().slice(0, 8);
  cache.put('sess:' + token, u.UserID, SESSION_SECONDS);
  audit(u.UserID, 'login');
  return { token: token, user: publicUser(u) };
}

function logout(token) {
  CacheService.getScriptCache().remove('sess:' + token);
  return { ok: true };
}

function isActive_(u) {
  return u.Active === true || u.Active === 'TRUE' || u.Active === 'Y';
}

// Returns the logged-in user, or throws. Pass roles to restrict an action.
function requireUser(token, roles) {
  var cache = CacheService.getScriptCache();
  var userId = token && cache.get('sess:' + token);
  if (!userId) throw new AuthError('Session expired. Please log in again.');
  var u = findOne('Users', 'UserID', userId);
  if (!u || !isActive_(u)) throw new AuthError('Account disabled.');
  if (roles && roles.indexOf(u.Role) < 0) throw new Error('You do not have permission for this.');
  cache.put('sess:' + token, userId, SESSION_SECONDS); // sliding expiry
  return u;
}

function AuthError(message) {
  this.message = message;
  this.auth = true;
}
AuthError.prototype = Object.create(Error.prototype);

function changePassword(user, oldPassword, newPassword) {
  if (hashPassword(String(oldPassword || ''), user.Salt) !== user.PasswordHash) throw new Error('Current password is wrong.');
  if (String(newPassword || '').length < 8) throw new Error('New password must be at least 8 characters.');
  var salt = newSalt();
  updateWhere('Users', 'UserID', user.UserID, { Salt: salt, PasswordHash: hashPassword(newPassword, salt), MustChangePassword: false });
  audit(user.UserID, 'changePassword');
  return { ok: true };
}


// ===== Checks.gs =====
// The RTG Vendor checks a heater twice for every ticket: before the store issues it (after RTG approves the request),
// and after FM hands it back. Each check lists the parts with OK / Not OK and a remark. RTG sees the result when it
// issues the heater and when it inspects the return. A check never blocks the store; it is shown as a warning.

var CHECK_STAGE = { BEFORE: 'Before issue', AFTER: 'After return' };

function teamEmails_(team) {
  return readTable('Users').filter(function (u) { return u.Team === team && isActive_(u) && u.Email; })
    .map(function (u) { return u.Email; }).join(',');
}

function parseChecks_(rows) {
  var users = {};
  readTable('Users').forEach(function (u) { users[u.UserID] = u.Name; });
  return rows.map(function (c) {
    return { CheckNo: c.CheckNo, TicketNo: c.TicketNo, Stage: c.Stage, CheckedBy: users[c.CheckedBy] || c.CheckedBy, CheckedOn: c.CheckedOn,
             Result: c.Result, Remarks: c.Remarks, items: parseList_(c.Items) };
  });
}

// Latest result for each part at each stage: {stage: {ComponentID: {ok, remark, CheckNo, CheckedBy, CheckedOn}}}.
function checkStatus_(checks) {
  var out = {};
  out[CHECK_STAGE.BEFORE] = {};
  out[CHECK_STAGE.AFTER] = {};
  checks.forEach(function (c) {
    if (!out[c.Stage]) return;
    c.items.forEach(function (i) {
      out[c.Stage][i.ComponentID] = { ok: !!i.ok, remark: i.remark || '', CheckNo: c.CheckNo, CheckedBy: c.CheckedBy, CheckedOn: c.CheckedOn };
    });
  });
  return out;
}

// Parts back at the store (handed back by FM or already inspected) that have no after-return check yet.
function returnedUnchecked_(items, checked) {
  return items.filter(function (i) { return (i.ReturnDeclaredOn || (i.ConditionIn && i.ConditionIn !== 'Missing')) && !checked[i.ComponentID]; });
}

// For the requests list and the home page: which tickets wait for an RTG Vendor check.
function ticketsToCheck_() {
  var checks = {}, items = {}, out = {};
  readTable('HeaterChecks').forEach(function (c) { (checks[c.TicketNo] = checks[c.TicketNo] || []).push(c); });
  readTable('TicketItems').forEach(function (i) { (items[i.TicketNo] = items[i.TicketNo] || []).push(i); });
  readTable('Tickets').forEach(function (t) {
    var mine = checks[t.TicketNo] || [];
    if (t.Status === TKT.AWAITING) {
      if (!mine.some(function (c) { return c.Stage === CHECK_STAGE.BEFORE; })) out[t.TicketNo] = CHECK_STAGE.BEFORE;
      return;
    }
    var after = {};
    mine.filter(function (c) { return c.Stage === CHECK_STAGE.AFTER; }).forEach(function (c) { parseList_(c.Items).forEach(function (i) { after[i.ComponentID] = true; }); });
    if (returnedUnchecked_(items[t.TicketNo] || [], after).length) out[t.TicketNo] = CHECK_STAGE.AFTER;
  });
  return out;
}

// d: {TicketNo, Stage, items: [{ComponentID, ok, remark}], Remarks}
function saveHeaterCheck(user, d) {
  if (!canMaintain_(user)) throw new Error('You do not have permission for this.');
  var tk = findOne('Tickets', 'TicketNo', d.TicketNo);
  if (!tk) throw new Error('No such ticket.');
  var stage = d.Stage, allowed = {};
  if (stage === CHECK_STAGE.BEFORE) {
    if (tk.Status !== TKT.AWAITING) throw new Error('This heater is already ' + String(tk.Status).toLowerCase() + '. The check before issue is done while it waits in the store.');
    var r = findOne('Requests', 'RequestNo', tk.RequestNo) || {};
    var from = partModels(readTable('HeaterModels'), r.ModelID || tk.ModelID);
    readTable('Components').forEach(function (c) { if (from.indexOf(c.ModelID) >= 0 && c.Status === STATUS.IN_STORE) allowed[c.ComponentID] = c.ComponentName; });
  } else if (stage === CHECK_STAGE.AFTER) {
    readTable('TicketItems').forEach(function (i) {
      if (i.TicketNo === tk.TicketNo && (i.ReturnDeclaredOn || (i.ConditionIn && i.ConditionIn !== 'Missing'))) allowed[i.ComponentID] = i.ComponentName;
    });
    if (!Object.keys(allowed).length) throw new Error('Nothing on this ticket has come back to the store yet.');
  } else {
    throw new Error('Unknown check.');
  }
  var items = [], seen = {}, bad = 0;
  parseList_(d.items).forEach(function (i) {
    var id = String(i.ComponentID || '');
    if (!(id in allowed)) throw new Error(id + ' is not a part you can check on this ticket now.');
    if (seen[id]) throw new Error(id + ' is listed twice.');
    seen[id] = true;
    var ok = i.ok === true || i.ok === 'true' || i.ok === 'OK', remark = String(i.remark || '').trim().slice(0, 500);
    if (!ok && !remark) throw new Error('Write what is wrong with ' + id + '.');
    if (!ok) bad++;
    items.push({ ComponentID: id, ComponentName: allowed[id], ok: ok, remark: remark });
  });
  if (!items.length) throw new Error('Check at least one part.');
  var no = nextNumber('check', 'VCK');
  var result = bad ? 'Not OK' : 'OK';
  appendRow('HeaterChecks', { CheckNo: no, TicketNo: tk.TicketNo, Stage: stage, CheckedBy: user.UserID, CheckedOn: new Date(), Result: result,
                              Items: JSON.stringify(items), Remarks: String(d.Remarks || '').trim() });
  audit(user.UserID, 'heaterCheck', tk.TicketNo, { stage: stage, parts: items.length, notOk: bad });
  queueMail('HEATER_CHECK', no, getSetting('RTGTeamMail', ''), '', 'RTG Vendor check ' + stage.toLowerCase() + ' on ' + tk.TicketNo + ': ' + result,
    mailHtml_('RTG Vendor checked ticket ' + tk.TicketNo + ' (' + stage.toLowerCase() + ')', [['Checked by', user.Name], ['Result', result], ['Remarks', d.Remarks || '']]
      .concat(items.map(function (i) { return [i.ComponentID + ' ' + i.ComponentName, i.ok ? 'OK' : 'Not OK: ' + i.remark]; })),
      bad ? 'Some parts are not OK. Please look at them before ' + (stage === CHECK_STAGE.BEFORE ? 'issuing the heater.' : 'closing the ticket.') : ''));
  return { CheckNo: no, Result: result };
}


// ===== Code.gs =====
// JSON API for the GitHub Pages front end.
// The front end POSTs {action, token, data} as text/plain (avoids the CORS preflight Apps Script can't answer).

var ADMIN = ['Admin'];
var READ_ONLY = ['me', 'lookups', 'heaterSearch', 'components', 'listUsers', 'listRequests', 'getRequest', 'dashboard', 'listTransfers',
                 'listConsumables', 'consumableDetail', 'consumableItems', 'listConsumableRequests',
                 'maintenanceDue', 'listMaintenanceLogs', 'getChecklist', 'masterList', 'adminLog', 'heaterGuide', 'listHeaters'];

// action -> { roles: roles allowed (null = any logged-in user), allow: extra check on the user, run: function(user, data) }
// RTG: the RTG team and admins (stock, approvals, issue and return, maintenance).
function RTG(u) { return isRtgTeam_(u); }
// MAINT: the RTG team and the RTG Vendor (heater checks and maintenance).
function MAINT_(u) { return canMaintain_(u); }
var ACTIONS = {
  me:             { roles: null,  run: function (u) { return { user: publicUser(u) }; } },
  changePassword: { roles: null,  run: function (u, d) { return changePassword(u, d.oldPassword, d.newPassword); } },
  lookups:        { roles: null,  run: function () { return apiLookups(); } },
  heaterSearch:   { allow: RTG,   run: function (u, d) { return apiHeaterSearch(d); } },
  components:     { allow: RTG,   run: function (u, d) { return apiComponents(d); } },
  listUsers:      { roles: ADMIN, run: function () { return listUsers(); } },
  saveUser:       { roles: ADMIN, run: function (u, d) { return saveUser(u, d); } },
  resetPassword:  { roles: ADMIN, run: function (u, d) { return resetPassword(u, d.UserID); } },
  deleteUser:     { roles: ADMIN, run: function (u, d) { return deleteUser(u, d.UserID); } },
  raiseRequest:   { roles: null,  run: function (u, d) { return raiseRequest(u, d); } },
  listRequests:   { roles: null,  run: function () { return listRequests(); } },
  getRequest:     { roles: null,  run: function (u, d) { return getRequest(u, d); } },
  dashboard:      { roles: null,  run: function (u) { return dashboard(u); } },
  decideRequest:  { allow: RTG,   run: function (u, d) { return decideRequest(u, d); } },
  issueTicket:    { allow: RTG,   run: function (u, d) { return issueTicket(u, d); } },
  returnTicket:   { allow: RTG,   run: function (u, d) { return returnTicket(u, d); } },
  closeIssue:     { allow: RTG,   run: function (u, d) { return closeIssue(u, d); } },
  declareReturn:  { roles: null,  run: function (u, d) { return declareReturn(u, d); } },
  explainIssue:   { roles: null,  run: function (u, d) { return explainIssue(u, d); } },
  maintenance:    { allow: RTG,   run: function (u, d) { return completeMaintenance(u, d); } },
  markFound:      { allow: RTG,   run: function (u, d) { return markFound(u, d); } },
  raiseTransfer:  { roles: null,  run: function (u, d) { return raiseTransfer(u, d); } },
  decideTransfer: { roles: null,  run: function (u, d) { return decideTransfer(u, d); } },
  listTransfers:  { roles: null,  run: function (u) { return listTransfers(u); } },
  listConsumables:          { allow: RTG,   run: function () { return listConsumables(); } },
  consumableDetail:         { allow: RTG,   run: function (u, d) { return consumableDetail(d); } },
  consumableItems:          { roles: null,  run: function () { return consumableItems(); } },
  saveConsumable:           { allow: RTG,   run: function (u, d) { return saveConsumable(u, d); } },
  stockEntry:               { allow: RTG,   run: function (u, d) { return stockEntry(u, d); } },
  uploadStock:              { allow: RTG,   run: function (u, d) { return uploadStock(u, d); } },
  raiseConsumableRequest:   { roles: null,  run: function (u, d) { return raiseConsumableRequest(u, d); } },
  listConsumableRequests:   { roles: null,  run: function (u) { return listConsumableRequests(u); } },
  decideConsumableRequest:  { allow: RTG,   run: function (u, d) { return decideConsumableRequest(u, d); } },
  issueConsumable:          { allow: RTG,   run: function (u, d) { return issueConsumable(u, d); } },
  maintenanceDue:           { roles: null,  run: function (u) { return maintenanceDue(u); } },
  logMaintenance:           { roles: null,  run: function (u, d) { return logMaintenance(u, d); } },
  saveHeaterCheck:          { roles: null,  run: function (u, d) { return saveHeaterCheck(u, d); } },
  listMaintenanceLogs:      { allow: MAINT_, run: function (u) { return listMaintenanceLogs(u); } },
  getChecklist:             { allow: MAINT_, run: function (u, d) { return getChecklist(u, d); } },
  verifyMaintenance:        { allow: RTG,   run: function (u, d) { return verifyMaintenance(u, d); } },
  masterList:               { roles: ADMIN, run: function (u, d) { return apiMasterList(d); } },
  masterSave:               { roles: ADMIN, run: function (u, d) { return apiMasterSave(u, d); } },
  masterDelete:             { roles: ADMIN, run: function (u, d) { return apiMasterDelete(u, d); } },
  heaterGuide:              { roles: ADMIN, run: function () { return apiHeaterGuide(); } },
  saveHeaterGuide:          { roles: ADMIN, run: function (u, d) { return apiSaveHeaterGuide(u, d); } },
  listHeaters:              { roles: ADMIN, run: function () { return apiListHeaters(); } },
  addHeater:                { roles: ADMIN, run: function (u, d) { return apiAddHeater(u, d); } },
  adminLog:                 { roles: ADMIN, run: function (u, d) { return apiLog(d); } },
  clearTestData:            { roles: ADMIN, run: function (u) { clearTestData(); audit(u.UserID, 'clearTestData'); return { ok: true }; } }
};

function doPost(e) {
  var req;
  try {
    req = JSON.parse(e.postData.contents);
  } catch (err) {
    return json_({ ok: false, error: 'Bad request.' });
  }
  return json_(handle(req));
}

function doGet() {
  return json_({ ok: true, app: 'RTG Heater API' });
}

// Separate from doPost so tests can call it directly.
function handle(req) {
  try {
    if (req.action === 'login') return { ok: true, data: login(req.data.userId, req.data.password) };
    if (req.action === 'logout') return { ok: true, data: logout(req.token) };
    var a = ACTIONS[req.action];
    if (!a) return { ok: false, error: 'Unknown action: ' + req.action };
    var user = requireUser(req.token, a.roles);
    if (a.allow && !a.allow(user)) throw new Error('You do not have permission for this.');
    if (READ_ONLY.indexOf(req.action) >= 0) return { ok: true, data: a.run(user, req.data || {}) };
    // One writer at a time, so two people can't approve or issue the same thing at once.
    var lock = LockService.getScriptLock();
    lock.waitLock(25000);
    try {
      return { ok: true, data: a.run(user, req.data || {}) };
    } finally {
      lock.releaseLock();
    }
  } catch (err) {
    return { ok: false, error: err.message || String(err), auth: !!err.auth };
  }
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}


// ===== Consumables.gs =====
// Consumables: stock by batch and expiry, daily entries, file upload, consumption reports,
// and requests (RTGC0001 -> approve -> CONS_0001 -> issue, which deducts stock).

var TXN = { RECEIPT: 'Receipt', ISSUE: 'Issue', ADJUST: 'Adjustment' };
var EXPIRY_WARN_DAYS = 30;

function num2_(v) {
  var n = Number(v);
  return isNaN(n) ? 0 : n;
}

function month_(dateStr) {
  return String(dateStr || '').slice(0, 7);
}

// The last n months as 'yyyy-MM', oldest first, ending with the month of `todayStr`.
function lastMonths_(todayStr, n) {
  var y = Number(todayStr.slice(0, 4)), m = Number(todayStr.slice(5, 7));
  var out = [];
  for (var i = n - 1; i >= 0; i--) {
    var mm = m - i, yy = y;
    while (mm <= 0) { mm += 12; yy--; }
    out.push(yy + '-' + (mm < 10 ? '0' : '') + mm);
  }
  return out;
}

function consumableData_() {
  return { items: readTable('Consumables'), batches: readTable('ConsumableBatches'), txns: readTable('ConsumableTransactions') };
}

function itemSummary_(item, batches, txns, t) {
  var mine = batches.filter(function (b) { return b.ItemID === item.ItemID && num2_(b.Qty) > 0; });
  var stock = mine.reduce(function (a, b) { return a + num2_(b.Qty); }, 0);
  var expired = mine.filter(function (b) { return b.ExpiryDate && String(b.ExpiryDate).slice(0, 10) < t; })
    .reduce(function (a, b) { return a + num2_(b.Qty); }, 0);
  var dated = mine.filter(function (b) { return b.ExpiryDate && String(b.ExpiryDate).slice(0, 10) >= t; })
    .map(function (b) { return String(b.ExpiryDate).slice(0, 10); }).sort();
  var months = lastMonths_(t, 6);
  var issued = txns.filter(function (x) { return x.ItemID === item.ItemID && x.Type === TXN.ISSUE; });
  var last6 = issued.filter(function (x) { return months.indexOf(month_(x.Date)) >= 0; }).reduce(function (a, x) { return a + num2_(x.Qty); }, 0);
  var thisMonth = issued.filter(function (x) { return month_(x.Date) === months[months.length - 1]; }).reduce(function (a, x) { return a + num2_(x.Qty); }, 0);
  var avg = Math.round((last6 / 6) * 10) / 10;
  var nearest = dated[0] || '';
  return {
    ItemID: item.ItemID, ItemName: item.ItemName, Manufacturer: item.Manufacturer, Unit: item.Unit, ReorderLevel: item.ReorderLevel,
    SAPStock: item.SAPStock, SAPStockUpdatedOn: item.SAPStockUpdatedOn,
    stock: stock, usableStock: stock - expired, expiredQty: expired, nearestExpiry: nearest,
    expiringSoon: !!nearest && daysBetween(t, nearest) <= EXPIRY_WARN_DAYS,
    lowStock: item.ReorderLevel !== '' && item.ReorderLevel !== undefined && stock - expired <= num2_(item.ReorderLevel),
    thisMonth: thisMonth, avgMonthly: avg, monthsCover: avg > 0 ? Math.round(((stock - expired) / avg) * 10) / 10 : null
  };
}

function listConsumables() {
  var d = consumableData_(), t = today();
  return d.items.map(function (i) { return itemSummary_(i, d.batches, d.txns, t); });
}

function consumableDetail(d) {
  var data = consumableData_(), t = today();
  var item = data.items.filter(function (i) { return i.ItemID === d.ItemID; })[0];
  if (!item) throw new Error('No such item.');
  var months = lastMonths_(t, 12);
  var issued = data.txns.filter(function (x) { return x.ItemID === item.ItemID && x.Type === TXN.ISSUE && months.indexOf(month_(x.Date)) >= 0; });
  var monthly = months.map(function (m) {
    return { month: m, qty: issued.filter(function (x) { return month_(x.Date) === m; }).reduce(function (a, x) { return a + num2_(x.Qty); }, 0) };
  });
  var depts = {};
  issued.forEach(function (x) { var k = x.Department || 'Not given'; depts[k] = (depts[k] || 0) + num2_(x.Qty); });
  var byDept = Object.keys(depts).map(function (k) { return { department: k, qty: depts[k] }; }).sort(function (a, b) { return b.qty - a.qty; });
  // Department x month table for the last 6 months.
  var m6 = months.slice(-6);
  var deptMonthly = byDept.map(function (dp) {
    return { department: dp.department, months: m6.map(function (m) {
      return issued.filter(function (x) { return (x.Department || 'Not given') === dp.department && month_(x.Date) === m; }).reduce(function (a, x) { return a + num2_(x.Qty); }, 0);
    }) };
  });
  return {
    summary: itemSummary_(item, data.batches, data.txns, t),
    batches: data.batches.filter(function (b) { return b.ItemID === item.ItemID && num2_(b.Qty) > 0; })
      .map(function (b) {
        var exp = String(b.ExpiryDate || '').slice(0, 10);
        return { BatchNo: b.BatchNo, Qty: num2_(b.Qty), ExpiryDate: exp, ReceivedOn: b.ReceivedOn, expired: !!exp && exp < t, daysLeft: exp ? daysBetween(t, exp) : null };
      })
      .sort(function (a, b) { return (a.ExpiryDate || '9999').localeCompare(b.ExpiryDate || '9999'); }),
    monthly: monthly, byDepartment: byDept, deptMonths: m6, deptMonthly: deptMonthly,
    transactions: data.txns.filter(function (x) { return x.ItemID === item.ItemID; }).slice(-50).reverse()
  };
}

function saveConsumable(admin, d) {
  var item = findOne('Consumables', 'ItemID', d.ItemID);
  if (!item) throw new Error('No such item.');
  var patch = {};
  ['Manufacturer', 'Unit', 'ReorderLevel'].forEach(function (k) { if (d[k] !== undefined) patch[k] = d[k]; });
  if (d.SAPStock !== undefined && String(d.SAPStock) !== String(item.SAPStock)) { patch.SAPStock = d.SAPStock; patch.SAPStockUpdatedOn = today(); }
  updateWhere('Consumables', 'ItemID', d.ItemID, patch);
  audit(admin.UserID, 'saveConsumable', d.ItemID, patch);
  return { ok: true };
}

// ---------- stock movements ----------
// Validates one entry against the current batches (mutating `batches` so a list of entries can be checked in order).
// Returns {txns: [...], batchOps: [...]} or throws.
function planEntry_(e, items, batches, user) {
  var item = items.filter(function (i) { return i.ItemID === e.ItemID || String(i.ItemName).toLowerCase() === String(e.ItemName || '').trim().toLowerCase(); })[0];
  if (!item) throw new Error('Unknown item "' + (e.ItemName || e.ItemID || '') + '".');
  var type = String(e.Type || '').trim();
  type = { receipt: TXN.RECEIPT, issue: TXN.ISSUE, adjustment: TXN.ADJUST, adjust: TXN.ADJUST }[type.toLowerCase()] || type;
  if ([TXN.RECEIPT, TXN.ISSUE, TXN.ADJUST].indexOf(type) < 0) throw new Error('Type must be Receipt, Issue or Adjustment.');
  var qty = Number(e.Qty);
  if (isNaN(qty) || qty === 0 || (type !== TXN.ADJUST && qty < 0)) throw new Error('Quantity must be a positive number' + (type === TXN.ADJUST ? ' (or negative to reduce)' : '') + '.');
  var date = String(e.Date || today()).slice(0, 10);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) throw new Error('Date must look like 2026-10-10.');
  if (date > today()) throw new Error('Date cannot be in the future.');
  var batchNo = String(e.BatchNo || '').trim();
  var base = { Date: date, ItemID: item.ItemID, Type: type, Department: e.Department || '', Conveyor: e.Conveyor || '', Ref: e.Ref || '', EnteredBy: user.UserID };
  var mine = batches.filter(function (b) { return b.ItemID === item.ItemID; });
  var txns = [];

  if (type === TXN.RECEIPT) {
    if (!batchNo) batchNo = 'B' + date.replace(/-/g, '');
    var exp = String(e.ExpiryDate || '').slice(0, 10);
    if (exp && !/^\d{4}-\d{2}-\d{2}$/.test(exp)) throw new Error('Expiry date must look like 2027-03-31.');
    var b = mine.filter(function (x) { return String(x.BatchNo) === batchNo; })[0];
    if (b) { b.Qty = num2_(b.Qty) + qty; if (exp) b.ExpiryDate = exp; b._dirty = true; }
    else batches.push({ ItemID: item.ItemID, BatchNo: batchNo, Qty: qty, ExpiryDate: exp, ReceivedOn: date, _new: true });
    txns.push(Object.assign({}, base, { Qty: qty, BatchNo: batchNo }));
  } else if (type === TXN.ISSUE) {
    if (!e.Department) throw new Error('Department is required for an issue.');
    // First expiring first out, skipping expired batches; or the batch named.
    var t = today();
    var pool = batchNo ? mine.filter(function (x) { return String(x.BatchNo) === batchNo; })
      : mine.filter(function (x) { return num2_(x.Qty) > 0 && !(x.ExpiryDate && String(x.ExpiryDate).slice(0, 10) < t); })
          .sort(function (a, c) { return String(a.ExpiryDate || '9999').localeCompare(String(c.ExpiryDate || '9999')); });
    if (batchNo && !pool.length) throw new Error('No batch "' + batchNo + '" for ' + item.ItemName + '.');
    var have = pool.reduce(function (a, x) { return a + num2_(x.Qty); }, 0);
    if (have < qty) throw new Error('Only ' + have + ' ' + (item.Unit || '') + ' of ' + item.ItemName + ' in stock' + (batchNo ? ' in batch ' + batchNo : ' (not expired)') + '.');
    var need = qty;
    pool.forEach(function (x) {
      if (need <= 0) return;
      var take = Math.min(num2_(x.Qty), need);
      if (take <= 0) return;
      x.Qty = num2_(x.Qty) - take; x._dirty = true;
      need -= take;
      txns.push(Object.assign({}, base, { Qty: take, BatchNo: x.BatchNo }));
    });
  } else {
    if (!batchNo) throw new Error('Batch number is required for an adjustment.');
    var bb = mine.filter(function (x) { return String(x.BatchNo) === batchNo; })[0];
    if (!bb) {
      if (qty < 0) throw new Error('No batch "' + batchNo + '" for ' + item.ItemName + '.');
      bb = { ItemID: item.ItemID, BatchNo: batchNo, Qty: 0, ExpiryDate: String(e.ExpiryDate || '').slice(0, 10), ReceivedOn: date, _new: true };
      batches.push(bb);
    }
    if (num2_(bb.Qty) + qty < 0) throw new Error('Batch ' + batchNo + ' has only ' + bb.Qty + '.');
    bb.Qty = num2_(bb.Qty) + qty; bb._dirty = true;
    txns.push(Object.assign({}, base, { Qty: qty, BatchNo: batchNo }));
  }
  var sap = e.SAPStock;
  return { txns: txns, sap: sap !== undefined && sap !== '' ? { ItemID: item.ItemID, SAPStock: Number(sap) } : null };
}

function saveBatches_(batches) {
  var dirty = {};
  batches.forEach(function (b) { if (b._dirty && !b._new) dirty[b.ItemID + '|' + b.BatchNo] = { Qty: b.Qty, ExpiryDate: b.ExpiryDate }; });
  if (Object.keys(dirty).length) updateRows('ConsumableBatches', function (o) { return dirty[o.ItemID + '|' + o.BatchNo] || null; });
  appendRows('ConsumableBatches', batches.filter(function (b) { return b._new; }).map(function (b) {
    return { ItemID: b.ItemID, BatchNo: b.BatchNo, Qty: b.Qty, ExpiryDate: b.ExpiryDate, ReceivedOn: b.ReceivedOn };
  }));
}

// Applies entries all-or-nothing. With dryRun, only validates and returns per-row errors.
function applyEntries_(user, entries, dryRun) {
  var items = readTable('Consumables'), batches = readTable('ConsumableBatches');
  var errors = [], txns = [], saps = {};
  entries.forEach(function (e, i) {
    try {
      var p = planEntry_(e, items, batches, user);
      txns = txns.concat(p.txns);
      if (p.sap) saps[p.sap.ItemID] = p.sap.SAPStock;
    } catch (err) {
      errors.push({ row: i + 1, error: err.message });
    }
  });
  if (errors.length || dryRun) return { ok: !errors.length, errors: errors, rows: entries.length, movements: txns.length };
  saveBatches_(batches);
  appendRows('ConsumableTransactions', txns);
  Object.keys(saps).forEach(function (id) { updateWhere('Consumables', 'ItemID', id, { SAPStock: saps[id], SAPStockUpdatedOn: today() }); });
  return { ok: true, errors: [], rows: entries.length, movements: txns.length };
}

function stockEntry(admin, d) {
  var res = applyEntries_(admin, [d], false);
  if (!res.ok) throw new Error(res.errors[0].error);
  audit(admin.UserID, 'stockEntry', d.ItemID, d);
  return res;
}

function uploadStock(admin, d) {
  var rows = parseList_(d.rows);
  if (!rows.length) throw new Error('The file has no rows.');
  if (rows.length > 2000) throw new Error('Please upload at most 2000 rows at a time.');
  var res = applyEntries_(admin, rows, !!d.dryRun);
  if (!d.dryRun && res.ok) audit(admin.UserID, 'uploadStock', '', { rows: rows.length });
  return res;
}

// ---------- consumable requests ----------
var CREQ = { PENDING: 'Pending', APPROVED: 'Approved', REJECTED: 'Rejected', ISSUED: 'Issued' };

function raiseConsumableRequest(user, d) {
  required_(d, [['ItemID', 'Material'], ['Qty', 'Quantity'], ['Department', 'Department'], ['Purpose', 'Purpose']]);
  var item = findOne('Consumables', 'ItemID', d.ItemID);
  if (!item) throw new Error('Unknown material.');
  if (!(Number(d.Qty) > 0)) throw new Error('Quantity must be more than 0.');
  var no = nextNumber('crequest', 'RTGC');
  appendRow('ConsumableRequests', { RequestNo: no, RaisedBy: user.UserID, RaisedOn: new Date(), ItemID: item.ItemID, Qty: Number(d.Qty), Department: d.Department,
                                    Conveyor: d.Conveyor || '', Purpose: d.Purpose, Status: CREQ.PENDING });
  audit(user.UserID, 'raiseConsumableRequest', no);
  queueMail('CONSUMABLE_REQUEST', no, getSetting('RTGTeamMail', ''), '', 'New consumable request ' + no + ': ' + item.ItemName,
    mailHtml_('New consumable request ' + no, [['Material', item.ItemName], ['Quantity', d.Qty + ' ' + (item.Unit || '')], ['Department', d.Department],
      ['Conveyor', d.Conveyor || ''], ['Purpose', d.Purpose], ['Raised by', user.Name]], 'Please approve or reject it in the app.'));
  return { RequestNo: no };
}

// Names only, for people who ask for material but don't see the stock.
function consumableItems() {
  return readTable('Consumables').map(function (i) { return { ItemID: i.ItemID, ItemName: i.ItemName, Unit: i.Unit }; });
}

// The store sees every request; anyone else sees the ones they raised.
function listConsumableRequests(user) {
  var items = {};
  readTable('Consumables').forEach(function (i) { items[i.ItemID] = i; });
  var users = {};
  readTable('Users').forEach(function (u) { users[u.UserID] = u.Name; });
  return readTable('ConsumableRequests').filter(function (r) { return !user || isRtgTeam_(user) || r.RaisedBy === user.UserID; }).map(function (r) {
    var it = items[r.ItemID] || {};
    return Object.assign({}, r, { ItemName: it.ItemName || r.ItemID, Unit: it.Unit || '', RaisedByName: users[r.RaisedBy] || r.RaisedBy });
  }).reverse();
}

function decideConsumableRequest(admin, d) {
  var r = findOne('ConsumableRequests', 'RequestNo', d.RequestNo);
  if (!r) throw new Error('No such request.');
  if (r.Status !== CREQ.PENDING) throw new Error('This request is already ' + String(r.Status).toLowerCase() + '.');
  var item = findOne('Consumables', 'ItemID', r.ItemID) || {};
  var raiser = findOne('Users', 'UserID', r.RaisedBy);
  var to = raiser && raiser.Email ? raiser.Email : '';
  if (d.decision === 'reject') {
    if (!String(d.reason || '').trim()) throw new Error('Please give a reason for rejecting.');
    updateWhere('ConsumableRequests', 'RequestNo', r.RequestNo, { Status: CREQ.REJECTED, DecidedBy: admin.UserID, DecidedOn: new Date(), RejectReason: d.reason });
    queueMail('CONSUMABLE_REJECTED', r.RequestNo, to, getSetting('RejectCC', ''), 'Consumable request ' + r.RequestNo + ' rejected by RTG team',
      mailHtml_('Request ' + r.RequestNo + ' has been rejected by the RTG team', [['Material', item.ItemName], ['Quantity', r.Qty], ['Reason', d.reason]]));
    audit(admin.UserID, 'rejectConsumableRequest', r.RequestNo);
    return { status: CREQ.REJECTED };
  }
  if (d.decision !== 'approve') throw new Error('Unknown decision.');
  var ticket = nextNumber('cticket', 'CONS_');
  updateWhere('ConsumableRequests', 'RequestNo', r.RequestNo, { Status: CREQ.APPROVED, DecidedBy: admin.UserID, DecidedOn: new Date(), TicketNo: ticket });
  queueMail('CONSUMABLE_APPROVED', r.RequestNo, to, '', 'Consumable request ' + r.RequestNo + ' approved: ticket ' + ticket,
    mailHtml_('Request ' + r.RequestNo + ' is approved. Your ticket number is ' + ticket, [['Material', item.ItemName], ['Quantity', r.Qty + ' ' + (item.Unit || '')]],
      'Bring this ticket number to the RTG Store to collect the material.'));
  audit(admin.UserID, 'approveConsumableRequest', r.RequestNo, { ticket: ticket });
  return { status: CREQ.APPROVED, TicketNo: ticket };
}

// Hands the material over: deducts stock (first expiring first) and records consumption against the department.
function issueConsumable(admin, d) {
  var q = String(d.no || '').trim().toUpperCase();
  var r = readTable('ConsumableRequests').filter(function (x) { return String(x.RequestNo).toUpperCase() === q || String(x.TicketNo).toUpperCase() === q; })[0];
  if (!r) throw new Error('No consumable request or ticket "' + d.no + '".');
  if (r.Status !== CREQ.APPROVED) throw new Error('This request is ' + String(r.Status).toLowerCase() + ', it cannot be issued.');
  var qty = Number(d.Qty || r.Qty);
  var res = applyEntries_(admin, [{ ItemID: r.ItemID, Type: TXN.ISSUE, Qty: qty, BatchNo: d.BatchNo || '', Department: r.Department, Conveyor: r.Conveyor, Ref: r.TicketNo }], false);
  if (!res.ok) throw new Error(res.errors[0].error);
  var used = readTable('ConsumableTransactions').filter(function (x) { return x.Ref === r.TicketNo; }).map(function (x) { return x.BatchNo; });
  updateWhere('ConsumableRequests', 'RequestNo', r.RequestNo, { Status: CREQ.ISSUED, IssuedQty: qty, IssuedBatch: used.join(', '), IssuedOn: new Date() });
  audit(admin.UserID, 'issueConsumable', r.TicketNo, { qty: qty });
  return { status: CREQ.ISSUED, batches: used };
}


// ===== Db.gs =====
// Thin table layer over the Sheet: each tab is a table, row 1 is the header.

function sheet_(name) {
  var sh = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sh) throw new Error('Missing tab "' + name + '". Run setup() first.');
  return sh;
}

function readTable(name) {
  var values = sheet_(name).getDataRange().getValues();
  var head = values[0];
  var rows = [];
  for (var r = 1; r < values.length; r++) {
    if (values[r].join('') === '') continue;
    var o = {};
    for (var c = 0; c < head.length; c++) o[head[c]] = cell_(values[r][c]);
    rows.push(o);
  }
  return rows;
}

function cell_(v) {
  if (v instanceof Date) {
    // Ask the script's time zone, not the machine's, whether the cell has a time (the Supabase server runs on UTC).
    var tz = Session.getScriptTimeZone();
    var hasTime = Utilities.formatDate(v, tz, 'HH:mm') !== '00:00';
    return Utilities.formatDate(v, tz, hasTime ? 'yyyy-MM-dd HH:mm' : 'yyyy-MM-dd');
  }
  return v;
}

function today() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function appendRows(name, objs) {
  if (!objs.length) return;
  var sh = sheet_(name);
  // Use the tab's real header so a column moved by hand still lines up.
  var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
  var rows = objs.map(function (o) {
    return head.map(function (h) { return o[h] === undefined ? '' : o[h]; });
  });
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, head.length).setValues(rows);
}

function appendRow(name, obj) {
  appendRows(name, [obj]);
}

// Merge `patch` into every row where keyCol === keyVal. Returns the number of rows changed.
function updateWhere(name, keyCol, keyVal, patch) {
  var sh = sheet_(name);
  var values = sh.getDataRange().getValues();
  var head = values[0];
  var k = head.indexOf(keyCol);
  var changed = 0;
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][k]) !== String(keyVal)) continue;
    Object.keys(patch).forEach(function (col) {
      var c = head.indexOf(col);
      if (c >= 0) values[r][c] = patch[col];
    });
    sh.getRange(r + 1, 1, 1, head.length).setValues([values[r]]);
    changed++;
  }
  return changed;
}

// One read and one write for many rows: fn(rowObject) returns a patch {col: value} or null.
function updateRows(name, fn) {
  var sh = sheet_(name);
  var values = sh.getDataRange().getValues();
  var head = values[0];
  var changed = 0;
  for (var r = 1; r < values.length; r++) {
    var o = {};
    for (var c = 0; c < head.length; c++) o[head[c]] = cell_(values[r][c]);
    var patch = fn(o);
    if (!patch) continue;
    Object.keys(patch).forEach(function (col) {
      var i = head.indexOf(col);
      if (i >= 0) values[r][i] = patch[col];
    });
    changed++;
  }
  if (changed) sh.getRange(1, 1, values.length, head.length).setValues(values);
  return changed;
}

// patches = {keyValue: {col: value}}
function updateMany(name, keyCol, patches) {
  return updateRows(name, function (o) { return patches[String(o[keyCol])] || null; });
}

// Delete every row where keyCol === keyVal. Returns the number of rows deleted.
function deleteWhere(name, keyCol, keyVal) {
  var sh = sheet_(name);
  var values = sh.getDataRange().getValues();
  var k = values[0].indexOf(keyCol);
  var deleted = 0;
  for (var r = values.length - 1; r >= 1; r--) {
    if (String(values[r][k]) !== String(keyVal)) continue;
    sh.deleteRows(r + 1, 1);
    deleted++;
  }
  return deleted;
}

function findOne(name, keyCol, keyVal) {
  var rows = readTable(name);
  for (var i = 0; i < rows.length; i++) if (String(rows[i][keyCol]) === String(keyVal)) return rows[i];
  return null;
}

function getSetting(key, fallback) {
  var row = findOne('Settings', 'Key', key);
  return row && row.Value !== '' ? row.Value : fallback;
}

// Next sequential number for a counter. Callers run inside handle()'s script lock, so numbers never repeat.
function nextNumber(counter, prefix) {
  var row = findOne('Counters', 'Name', counter);
  var n = (row ? Number(row.Value) : 0) + 1;
  if (row) updateWhere('Counters', 'Name', counter, { Value: n });
  else appendRow('Counters', { Name: counter, Value: n });
  return formatNumber(prefix, n, 4);
}

function audit(userId, action, ref, details) {
  appendRow('AuditLog', { Time: new Date(), UserID: userId, Action: action, Ref: ref || '', Details: details ? JSON.stringify(details) : '' });
}


